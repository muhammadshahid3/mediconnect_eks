NODE_ENV=development
PORT=5000

# MongoDB connection string
# Local dev: mongodb://localhost:27017/mediconnect
# Docker Compose: mongodb://mongo:27017/mediconnect
MONGO_URI=mongodb://localhost:27017/mediconnect

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS if you lock it down further)
CLIENT_URL=http://localhost:5173
